<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_bg"
    android:orientation="vertical"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Status bar (shows recording/transcribing state) -->
    <TextView
        android:id="@+id/status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Row 1: Q W E R T Y U I O P -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp">

        <TextView style="@style/KeyStyle" android:id="@+id/key_q" android:text="q" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_w" android:text="w" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_e" android:text="e" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_r" android:text="r" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_t" android:text="t" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_y" android:text="y" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_u" android:text="u" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_i" android:text="i" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_o" android:text="o" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_p" android:text="p" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
    </LinearLayout>

    <!-- Row 2: A S D F G H J K L -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="2dp">

        <TextView style="@style/KeyStyle" android:id="@+id/key_a" android:text="a" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_s" android:text="s" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_d" android:text="d" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_f" android:text="f" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_g" android:text="g" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_h" android:text="h" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_j" android:text="j" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_k" android:text="k" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_l" android:text="l" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
    </LinearLayout>

    <!-- Row 3: SHIFT Z X C V B N M BACKSPACE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp">

        <ImageView
            android:id="@+id/key_shift"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_special_background"
            android:contentDescription="Shift"
            android:padding="12dp"
            android:src="@drawable/ic_shift" />

        <TextView style="@style/KeyStyle" android:id="@+id/key_z" android:text="z" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_x" android:text="x" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_c" android:text="c" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_v" android:text="v" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_b" android:text="b" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_n" android:text="n" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />
        <TextView style="@style/KeyStyle" android:id="@+id/key_m" android:text="m" android:layout_width="0dp" android:layout_weight="1" android:layout_margin="2dp" />

        <ImageView
            android:id="@+id/key_backspace"
            android:layout_width="0dp"
            android:layout_weight="1.5"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_special_background"
            android:contentDescription="Backspace"
            android:padding="12dp"
            android:src="@drawable/ic_backspace" />
    </LinearLayout>

    <!-- Row 4: ?123 , MIC SPACE . ENTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/key_symbols"
            style="@style/KeyStyle"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_margin="2dp"
            android:background="@drawable/key_special_background"
            android:text="?123"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/key_comma"
            style="@style/KeyStyle"
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_margin="2dp"
            android:text="," />

        <!-- 🎤 MIC BUTTON -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:layout_margin="2dp">

            <ImageView
                android:id="@+id/key_mic"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/mic_button_background"
                android:contentDescription="Voice input"
                android:padding="10dp"
                android:src="@drawable/ic_mic" />
        </FrameLayout>

        <!-- SPACE BAR -->
        <TextView
            android:id="@+id/key_space"
            style="@style/KeyStyle"
            android:layout_width="0dp"
            android:layout_weight="3"
            android:layout_margin="2dp"
            android:background="@drawable/key_special_background"
            android:text="espacio"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/key_period"
            style="@style/KeyStyle"
            android:layout_width="0dp"
            android:layout_weight="0.8"
            android:layout_margin="2dp"
            android:text="." />

        <ImageView
            android:id="@+id/key_enter"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="48dp"
            android:layout_margin="2dp"
            android:background="@drawable/key_special_background"
            android:contentDescription="Enter"
            android:padding="12dp"
            android:src="@drawable/ic_return" />
    </LinearLayout>

</LinearLayout>
